{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Abuzar Next",
  "version": "0.1.0",
  "identifier": "com.abuzar.next",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev -- --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/build"
  },
  "app": {
    "windows": [
      {
        "title": "Abuzar Next",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:5173; connect-src 'self' http://127.0.0.1:* https://*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
