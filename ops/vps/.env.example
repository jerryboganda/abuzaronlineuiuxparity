# Copy to `.env` in this directory on the VPS (never commit the real `.env` —
# it's gitignored). docker-compose loads it via `env_file:` for the api
# service.
#
# Use a dedicated, least-privileged role provisioned by
# ops/postgres/provision-app-role.sh (+ grant-app-role.sql), never the
# shared platform-postgres admin role — that role is used by multiple
# unrelated apps on this host, and the API only needs DML on its own
# database, not admin access to the whole Postgres instance.
DATABASE_URL=postgres://abuzarnext_app:<generate-a-strong-password>@platform-postgres:5432/abuzarnext?sslmode=disable
