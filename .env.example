# Central API
ABUZAR_API_ADDR=:8080
# Keep the schema-owner DSN only in a protected migration/setup shell.
ABUZAR_ADMIN_DATABASE_URL=postgres://<schema-owner>@127.0.0.1:5432/abuzar_next?sslmode=disable
ABUZAR_APP_ROLE=abuzar_app
# Optional protected value. Omit it when local PostgreSQL uses trust auth.
ABUZAR_APP_ROLE_PASSWORD=
# Runtime/API DSN must use the non-owner role.
ABUZAR_APP_DATABASE_URL=postgres://<app-role>@127.0.0.1:5432/abuzar_next?sslmode=disable
DATABASE_URL=postgres://<app-role>@127.0.0.1:5432/abuzar_next?sslmode=disable
ABUZAR_CORS_ORIGINS=http://localhost:5173
ABUZAR_COOKIE_SECURE=false

# Branch edge
ABUZAR_EDGE_ADDR=:8091
ABUZAR_EDGE_DB=./data/branch-edge.sqlite
ABUZAR_CENTRAL_API=https://api.example.invalid
ABUZAR_EDGE_SHARED_SECRET=generate-a-long-random-branch-secret
ABUZAR_EDGE_CENTRAL_URL=https://api.example.invalid
ABUZAR_EDGE_CENTRAL_SESSION=
ABUZAR_EDGE_SYNC_INTERVAL=30s

# Branch edge: real SMTP client adapter (services/edge/internal/hardware/smtp.go).
# Leave SMTP_HOST empty to keep the email hardware capability unconfigured
# (the edge service will keep returning hardware_adapter_unavailable / 503).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# One of: None, TLS (STARTTLS, e.g. port 587), SSL (implicit TLS, e.g. port 465)
SMTP_ENCRYPTION=TLS

# Branch edge: real Web-SMS-gateway HTTP client adapter
# (services/edge/internal/hardware/sms.go). Leave SMS_GATEWAY_URL_TEMPLATE
# empty to keep the sms hardware capability unconfigured. The template may
# reference {user} {password} {mask} {apikey} {to} {message} placeholders,
# each substituted with its URL-escaped value; match it to your gateway's
# documented GET/POST contract (e.g. a Pakistani telco Web SMS API).
SMS_GATEWAY_URL_TEMPLATE=
SMS_GATEWAY_METHOD=GET
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_MASK=
SMS_GATEWAY_API_KEY=
# Optional stricter success rules; leave empty/0 to accept any 2xx response.
SMS_GATEWAY_SUCCESS_STATUS=
SMS_GATEWAY_SUCCESS_CONTAINS=

# Central API: reach a specific branch-edge instance to actually send
# email/SMS for the maintenance test-email/send-email/test-sms/send-sms
# actions (services/api/internal/httpapi/channel_send.go). Leave
# ABUZAR_EDGE_CHANNEL_URL empty to keep those maintenance actions reporting
# an honest not_configured, exactly like the pg_dump/pg_restore fallback.
ABUZAR_EDGE_CHANNEL_URL=
ABUZAR_EDGE_CHANNEL_SECRET=
