# Central API
ABUZAR_API_ADDR=:8080
# Keep the schema-owner DSN only in a protected migration/setup shell.
ABUZAR_ADMIN_DATABASE_URL=postgres://<schema-owner>@127.0.0.1:5432/abuzar_next?sslmode=disable
ABUZAR_APP_ROLE=abuzar_app
# Optional protected value. Omit it when local PostgreSQL uses trust auth.
ABUZAR_APP_ROLE_PASSWORD=
# Runtime/API DSN must use the non-owner role.
ABUZAR_APP_DATABASE_URL=postgres://<app-role>@127.0.0.1:5432/abuzar_next?sslmode=disable
DATABASE_URL=postgres://<app-role>@127.0.0.1:5432/abuzar_next?sslmode=disable
ABUZAR_CORS_ORIGINS=http://localhost:5173
ABUZAR_COOKIE_SECURE=false

# Branch edge
ABUZAR_EDGE_ADDR=:8091
ABUZAR_EDGE_DB=./data/branch-edge.sqlite
ABUZAR_CENTRAL_API=https://api.example.invalid
ABUZAR_EDGE_SHARED_SECRET=generate-a-long-random-branch-secret
ABUZAR_EDGE_CENTRAL_URL=https://api.example.invalid
ABUZAR_EDGE_CENTRAL_SESSION=
ABUZAR_EDGE_SYNC_INTERVAL=30s
