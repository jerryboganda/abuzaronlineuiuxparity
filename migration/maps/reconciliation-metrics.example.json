{
  "metrics": [
    {
      "name": "sales_total",
      "sourceQuery": "SELECT COALESCE(SUM(total_amount), 0) FROM dbo.LegacySales",
      "targetQuery": "SELECT COALESCE(SUM(total_amount), 0) FROM public.sales_documents",
      "tolerance": 0.01
    },
    {
      "name": "sales_count",
      "sourceQuery": "SELECT COUNT_BIG(*) FROM dbo.LegacySales",
      "targetQuery": "SELECT COUNT(*) FROM public.sales_documents",
      "tolerance": 0
    }
  ]
}
